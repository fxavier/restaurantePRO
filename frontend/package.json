{
  "name": "restaurantpro-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm generate && tsc --noEmit && pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "generate": "pnpm --filter api-client generate",
    "e2e": "playwright test",
    "e2e:stack:up": "../deploy/e2e/stack.sh up",
    "e2e:stack": "../deploy/e2e/stack.sh test",
    "e2e:stack:down": "../deploy/e2e/stack.sh down"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
