# Copy to deploy/.env and fill in. deploy/.env is git-ignored: never commit real values.
# Passwords do NOT go here: they live in deploy/secrets/ (see deploy/README.md, "First install").

# Name clients use to reach the server on the LAN (DNS or hosts file). Caddy issues its certificate for it.
RESTAURANTPRO_HOSTNAME=restaurantpro.lan
RESTAURANTPRO_HTTPS_PORT=443
RESTAURANTPRO_HTTP_PORT=80

# Backend image tag (built locally from ../backend).
RESTAURANTPRO_VERSION=local
# JVM flags.
RESTAURANTPRO_JAVA_OPTS=-XX:MaxRAMPercentage=75

# Company and first administrator (D30). Consumed ONCE, at the first start against an empty database;
# afterwards edit the company profile in the BackOffice. Changing these later has no effect.
# Bound by Spring to restaurantpro.bootstrap.company.* / restaurantpro.bootstrap.admin.* (S1/S2).
RESTAURANTPRO_BOOTSTRAP_COMPANY_NAME=Example Company, Lda
RESTAURANTPRO_BOOTSTRAP_COMPANY_TAX_ID=000000000
RESTAURANTPRO_BOOTSTRAP_COMPANY_COUNTRY=XX
RESTAURANTPRO_BOOTSTRAP_COMPANY_CURRENCY=XXX
RESTAURANTPRO_BOOTSTRAP_ADMIN_USERNAME=admin
# The admin's initial password is read from deploy/secrets/admin_initial_password, also once;
# the admin must change it at first login.

# Fiscal (B4, D54). R2 ships only the NON-CERTIFIED internal fiscal adapter, and the backend refuses to start
# with it unless this is true. Pilot only, until a certified fiscal adapter for the chosen market exists;
# documents are printed as DOCUMENTO NÃO FISCAL. Leave false for any installation with fiscal obligations.
RESTAURANTPRO_FISCAL_ALLOW_NON_CERTIFIED=false

# Backups (D98). production (the default when unset) refuses to run PostgreSQL or any backup without encryption;
# test is for developer stacks only (plaintext allowed, with a WARNING). Any other value makes the scripts exit.
RESTAURANTPRO_ENVIRONMENT=production
# age recipients (public keys only): the operational key and the recovery key, one per line (README, "Backup
# encryption"). Never put an identity (private key) on this server. Relative paths are relative to deploy/.
BACKUP_AGE_RECIPIENTS_FILE=./backup-recipients.txt
# Off-box destination of offbox-sync.sh: user@host:path over ssh (authorized_keys forces rrsync -wo -no-del),
# or /absolute/path of a removable disk. The host key is pinned in deploy/offbox_known_hosts.
OFFBOX_TARGET=restaurantpro@backup-host.lan:
OFFBOX_SSH_PORT=22
OFFBOX_SSH_KEY=/home/restaurantpro/.ssh/offbox_ed25519

# R4 (Stage 4) scheduled jobs, optional (compose.yaml uses these defaults when unset).
# How often BOOKED reservations past their grace become NO_SHOW (P47), an ISO-8601 duration.
RESTAURANTPRO_DINING_NO_SHOW_INTERVAL=PT1M
# When the nightly check that stock balances = Σ movements runs (D113), a Spring cron in server time.
RESTAURANTPRO_INVENTORY_RECONCILE_CRON="0 20 4 * * *"
# The load smoke (deploy/load/load-smoke.sh) reads LOAD_ADMIN_USERNAME and LOAD_ADMIN_PASSWORD_FILE from the shell
# of the machine that runs it, never from this file: it runs against test installations only.
