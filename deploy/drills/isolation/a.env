# Installation A of the two-installation isolation drill (deploy/test-two-installations.sh, PRD S44, spec §14 #1).
# Throwaway values only. The drill supplies, per run, what must never sit in a committed file: the secret
# directory (RP_ISOLATION_SECRETS, see compose.isolation.yaml) and the recipients file (BACKUP_AGE_RECIPIENTS_FILE,
# two throwaway age keys, D98). Both installations use the same admin username on purpose: only the password,
# the session and the database tell them apart.
COMPOSE_PROJECT_NAME=rp-a
RESTAURANTPRO_ENVIRONMENT=production
RESTAURANTPRO_HOSTNAME=rp-a.lan
RESTAURANTPRO_HTTPS_PORT=18443
RESTAURANTPRO_HTTP_PORT=18080
# Its own tag, so the drill never replaces a developer's restaurantpro-backend:local.
RESTAURANTPRO_VERSION=isolation-drill
RESTAURANTPRO_JAVA_OPTS=-XX:MaxRAMPercentage=50
RESTAURANTPRO_BOOTSTRAP_COMPANY_NAME=Drill Company A, Lda
RESTAURANTPRO_BOOTSTRAP_COMPANY_TAX_ID=DRILL-A-1
RESTAURANTPRO_BOOTSTRAP_COMPANY_COUNTRY=MZ
RESTAURANTPRO_BOOTSTRAP_COMPANY_CURRENCY=MZN
RESTAURANTPRO_BOOTSTRAP_ADMIN_USERNAME=admin
# The backend refuses to start with the non-certified fiscal adapter otherwise (B4/D54); a drill has no fiscal duty.
RESTAURANTPRO_FISCAL_ALLOW_NON_CERTIFIED=true
